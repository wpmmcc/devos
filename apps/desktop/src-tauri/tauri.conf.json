{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevOS",
  "version": "0.1.0",
  "identifier": "ai.devos.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DevOS - Agent Workbench",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "DevOS - Local Agent Workbench & Project Orchestration",
    "longDescription": "DevOS integrates heterogeneous container runtimes (DDEV, DevContainers, Docker), unified command bus, VCS time machine, and AI agent control plane into a project-centric desktop environment.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "frameworks": []
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
